# apps/web configuration. Copy to .env.local (gitignored) and fill in.
#
# Every VITE_-prefixed value is inlined into the browser bundle by Vite and is
# therefore public. Never put a secret here under any name — in particular
# Clerk's CLERK_SECRET_KEY, which the app never uses (only the authenticated
# Playwright suite reads it, from the environment it is started in).

# Where the API lives. Defaults to http://127.0.0.1:3000 when unset.
# VITE_API_URL=http://127.0.0.1:3000

# Clerk's publishable key: Dashboard -> API keys -> Publishable key.
#
# REQUIRED. Clerk is how the browser signs in, and there is no other way in:
# unset, the app shows a notice saying what to configure instead of itself.
# The server needs the same instance's CLERK_JWT_KEY (apps/server/.env.example).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
