{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "token:issue": "tsx src/bin/issue-token.ts",
    "migrate": "tsx src/bin/migrate.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.15.1",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/sql-pg": "4.0.0-beta.102",
    "@taverns/api": "workspace:*",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@taverns/eslint-config": "workspace:*",
    "@taverns/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
